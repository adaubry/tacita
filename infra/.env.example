# Copie en .env, ne jamais committer .env (secrets réels)

SERVER_NAME=chat.example.org

POSTGRES_USER=synapse
POSTGRES_PASSWORD=change-me

SYNAPSE_REGISTRATION_SHARED_SECRET=change-me
SYNAPSE_MACAROON_SECRET_KEY=change-me
SYNAPSE_FORM_SECRET=change-me


S3_BUCKET=synapse-media
# identifiant public de la clé (au moins 8 caractères, Garage refuse en deçà) ; le secret
# fait au moins 16 caractères. `pnpm admin init` pose les deux.
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
# 32 octets en hexadécimal ; génération : openssl rand -hex 32
GARAGE_RPC_SECRET=change-me

# --- Passerelle Web Push (service de `push-gateway`) ---
# Génération des clés : pnpm --filter push-gateway exec web-push generate-vapid-keys
# VAPID_SUBJECT identifie l'émetteur auprès des services push : mailto: ou https:.
VAPID_SUBJECT=mailto:admin@example.org
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
# Synapse refuse ses propres requêtes sortantes vers les plages privées (protection
# SSRF). **Deux clients sortants de Synapse en dépendent, pas un seul** : la découverte
# OIDC (README.md, « login OIDC ») et — depuis le 24/08/2026 — l'appel du pusher vers
# `http://push-gateway:8008`, qui est par construction une adresse du réseau du compose.
# Laissée vide, la pile démarre, le pusher s'enregistre, l'interface annonce des
# notifications actives, et **aucun push ne part jamais** : Synapse n'appelle pas la
# passerelle, et rien ne le dit. Voir README.md.
# La plage est celle du réseau Docker : 172.16.0.0/12 couvre les pools par défaut. Un
# hôte configuré autrement (192.168.0.0/16) doit nommer la sienne, la plus étroite
# possible — c'est une protection qu'on entrouvre, pas qu'on retire.
SYNAPSE_IP_RANGE_WHITELIST=["172.16.0.0/12"]
# *(SHARD_ORIGIN vivait ici. Il n'ouvrait qu'une chose : l'URL de retour du SSO dans
# `sso.client_whitelist`. Le SSO supprimé (D-12, 25/08/2026), un shard servi ailleurs n'a
# plus rien à déclarer côté Synapse — il lui suffit de pointer `NEXT_PUBLIC_HOMESERVER_URL`
# sur le bon hôte.)*

# --- Service de liens d'invitation (raccordé par) ---
# Aucune variable propre : il compose son DATABASE_URL depuis POSTGRES_USER/PASSWORD
# ci-dessus, sur sa base dédiée `invite_tokens`, et joint Synapse par le réseau du
# compose. **Aucun secret d'administration ne doit apparaître ici pour lui** — la
# `invite-tokens` lui interdit tout pouvoir Matrix, et un test de configuration le vérifie.

# --- RTC (overlay rtc/docker-compose.yml, monté par défaut) ---
# Deux variables, et rien d'autre à décider : le SFU et le TURN tiennent sur l'IP de
# l'hôte, quelle qu'elle soit. `pnpm admin init` les remplit.
LIVEKIT_KEY=change-me
LIVEKIT_SECRET=change-me
# Aucune variable pour le TURN : il s'annonce sous ${SERVER_NAME}, sur le port 5349,
# avec le certificat de proxy/certs — qui porte ce nom par construction.
# Aucune non plus pour Element Call : servi sous `call.${SERVER_NAME}`, capté par le
# bloc `server` de rtc/call.conf par expression régulière. **Ce nom doit être un SAN du
# certificat**, et c'est cette URL que le shard met dans NEXT_PUBLIC_ELEMENT_CALL_URL.
